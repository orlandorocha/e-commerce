# ====================================
# Aplicacao
# ====================================
NODE_ENV=development
PORT=3001
API_PREFIX=api
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ====================================
# Banco de dados (PostgreSQL / Neon)
# ====================================
# URL pooled usada em runtime pelo Prisma Client
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# URL direta (nao-pooled) usada para migrations
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# ====================================
# JWT
# ====================================
JWT_ACCESS_SECRET=troque-este-segredo-de-acesso
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh
JWT_REFRESH_EXPIRES_IN=7d

# ====================================
# Redis (cache / sessoes)
# ====================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=3600

# ====================================
# Upload
# ====================================
UPLOAD_DRIVER=local
UPLOAD_DIR=uploads
# AWS S3 (preparado)
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ====================================
# SMTP (notificacoes por email)
# ====================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Loja <no-reply@loja.com>"

# ====================================
# Seguranca / Rate limit
# ====================================
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# ====================================
# Seed admin padrao
# ====================================
SEED_ADMIN_EMAIL=admin@loja.com
SEED_ADMIN_PASSWORD=Admin@123
