// ============================================================
//  Prisma Schema - Backend E-commerce
//  PostgreSQL (Neon) + Prisma ORM
//  Cobre todos os dominios definidos na especificacao.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
//  ENUMS
// ============================================================

enum UserRole {
  ADMIN
  GERENTE
  FINANCEIRO
  ESTOQUE
  ATENDENTE
  CLIENTE
}

enum UserStatus {
  ATIVO
  INATIVO
  BLOQUEADO
  PENDENTE
}

enum ProductType {
  FISICO
  DIGITAL
}

enum ProductStatus {
  RASCUNHO
  PUBLICADO
  ARQUIVADO
}

enum OrderStatus {
  PENDENTE
  PAGO
  ENVIADO
  ENTREGUE
  CANCELADO
  DEVOLVIDO
}

enum PaymentStatus {
  PENDENTE
  APROVADO
  RECUSADO
  ESTORNADO
  CANCELADO
}

enum PaymentMethod {
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  BOLETO
  STRIPE
  MERCADO_PAGO
  PAGSEGURO
}

enum PaymentGateway {
  STRIPE
  MERCADO_PAGO
  PAGSEGURO
  MANUAL
}

enum CouponType {
  PERCENTUAL
  VALOR_FIXO
}

enum StockMovementType {
  ENTRADA
  SAIDA
  TRANSFERENCIA
  AJUSTE
  RESERVA
  LIBERACAO
}

enum ShippingCarrier {
  CORREIOS
  MELHOR_ENVIO
  TRANSPORTADORA
}

enum ReviewStatus {
  PENDENTE
  APROVADO
  REPROVADO
}

enum PostStatus {
  RASCUNHO
  PUBLICADO
  ARQUIVADO
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  PENDENTE
  ENVIADA
  FALHA
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
}

// ============================================================
//  AUTENTICACAO / USUARIOS / PERMISSOES
// ============================================================

model User {
  id                String     @id @default(uuid())
  name              String
  email             String     @unique
  password          String
  phone             String?
  document          String? // CPF/CNPJ
  avatar            String?
  role              UserRole   @default(CLIENTE)
  status            UserStatus @default(PENDENTE)
  emailVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  lastLoginIp       String?

  // Relacionamentos
  permissions       UserPermission[]
  refreshTokens     RefreshToken[]
  passwordResets    PasswordReset[]
  emailVerifications EmailVerification[]
  customer          Customer?
  addresses         Address[]
  orders            Order[]
  reviews           Review[]
  carts             Cart[]
  wishlist          WishlistItem[]
  favorites         Favorite[]
  couponUsages      CouponUsage[]
  posts             Post[]
  comments          Comment[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  stockMovements    StockMovement[]

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  @@index([role])
  @@index([status])
  @@map("users")
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique // ex: products.create
  description String?
  users       UserPermission[]

  createdAt   DateTime         @default(now())

  @@map("permissions")
}

model UserPermission {
  userId       String
  permissionId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permissions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  userAgent String?
  ip        String?
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_resets")
}

model EmailVerification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verifications")
}

// ============================================================
//  CLIENTES
// ============================================================

model Customer {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthDate    DateTime?
  gender       String?
  newsletter   Boolean  @default(false)
  totalSpent   Decimal  @default(0) @db.Decimal(12, 2)
  ordersCount  Int      @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("customers")
}

model Address {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String? // Casa, Trabalho...
  recipient    String?
  zipCode      String
  street       String
  number       String
  complement   String?
  district     String
  city         String
  state        String
  country      String   @default("BR")
  isDefault    Boolean  @default(false)

  shippingOrders Order[] @relation("ShippingAddress")
  billingOrders  Order[] @relation("BillingAddress")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("favorites")
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("wishlist_items")
}

// ============================================================
//  CATALOGO: CATEGORIAS / MARCAS / FORNECEDORES
// ============================================================

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  order       Int        @default(0)
  active      Boolean    @default(true)

  // SEO
  metaTitle       String?
  metaDescription String?

  products    ProductCategory[]
  coupons     CouponCategory[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  @@index([parentId])
  @@map("categories")
}

model Brand {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  logo        String?
  active      Boolean  @default(true)

  // SEO
  metaTitle       String?
  metaDescription String?

  products    Product[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@map("brands")
}

model Supplier {
  id        String    @id @default(uuid())
  name      String
  email     String?
  phone     String?
  document  String?
  address   String?
  notes     String?
  active    Boolean   @default(true)

  products  Product[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("suppliers")
}

// ============================================================
//  PRODUTOS / ATRIBUTOS / VARIACOES
// ============================================================

model Product {
  id               String        @id @default(uuid())
  name             String
  slug             String        @unique
  shortDescription String?
  description      String?
  sku              String        @unique
  ean              String?

  brandId          String?
  brand            Brand?        @relation(fields: [brandId], references: [id], onDelete: SetNull)
  supplierId       String?
  supplier         Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  type             ProductType   @default(FISICO)
  status           ProductStatus @default(RASCUNHO)

  price            Decimal       @db.Decimal(12, 2)
  promoPrice       Decimal?      @db.Decimal(12, 2)
  cost             Decimal?      @db.Decimal(12, 2)

  // Estoque
  manageStock      Boolean       @default(true)
  stock            Int           @default(0)
  reservedStock    Int           @default(0)
  lowStockAlert    Int           @default(5)

  // Logistica
  weight           Decimal?      @db.Decimal(10, 3)
  width            Decimal?      @db.Decimal(10, 2)
  height           Decimal?      @db.Decimal(10, 2)
  length           Decimal?      @db.Decimal(10, 2)

  // Flags
  featured         Boolean       @default(false)
  isNew            Boolean       @default(false)
  bestSeller       Boolean       @default(false)

  // SEO
  metaTitle        String?
  metaDescription  String?

  // Relacionamentos
  categories       ProductCategory[]
  images           ProductImage[]
  videos           ProductVideo[]
  tags             ProductTag[]
  attributes       ProductAttributeValue[]
  variations       ProductVariation[]
  relatedFrom      RelatedProduct[]  @relation("RelatedFrom")
  relatedTo        RelatedProduct[]  @relation("RelatedTo")
  similarFrom      SimilarProduct[]  @relation("SimilarFrom")
  similarTo        SimilarProduct[]  @relation("SimilarTo")

  orderItems       OrderItem[]
  cartItems        CartItem[]
  reviews          Review[]
  favorites        Favorite[]
  wishlist         WishlistItem[]
  stockMovements   StockMovement[]
  couponProducts   CouponProduct[]

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  @@index([status])
  @@index([brandId])
  @@index([featured])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  order     Int      @default(0)
  isCover   Boolean  @default(false)

  @@index([productId])
  @@map("product_images")
}

model ProductVideo {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  title     String?
  order     Int      @default(0)

  @@index([productId])
  @@map("product_videos")
}

model Tag {
  id       String       @id @default(uuid())
  name     String       @unique
  slug     String       @unique
  products ProductTag[]

  @@map("tags")
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@map("product_tags")
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_categories")
}

model RelatedProduct {
  productId String
  relatedId String
  product   Product @relation("RelatedFrom", fields: [productId], references: [id], onDelete: Cascade)
  related   Product @relation("RelatedTo", fields: [relatedId], references: [id], onDelete: Cascade)

  @@id([productId, relatedId])
  @@map("related_products")
}

model SimilarProduct {
  productId String
  similarId String
  product   Product @relation("SimilarFrom", fields: [productId], references: [id], onDelete: Cascade)
  similar   Product @relation("SimilarTo", fields: [similarId], references: [id], onDelete: Cascade)

  @@id([productId, similarId])
  @@map("similar_products")
}

// Atributos personalizaveis (cor, tamanho, material, voltagem...)
model Attribute {
  id      String           @id @default(uuid())
  name    String           @unique // Cor, Tamanho...
  slug    String           @unique
  values  AttributeValue[]

  createdAt DateTime       @default(now())

  @@map("attributes")
}

model AttributeValue {
  id          String   @id @default(uuid())
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String // Azul, P, M, 110V...
  meta        String? // hex de cor, etc.

  productValues  ProductAttributeValue[]
  variationValues VariationAttributeValue[]

  @@unique([attributeId, value])
  @@map("attribute_values")
}

model ProductAttributeValue {
  id               String         @id @default(uuid())
  productId        String
  attributeValueId String
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeValueId])
  @@map("product_attribute_values")
}

model ProductVariation {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String   @unique
  price      Decimal? @db.Decimal(12, 2)
  promoPrice Decimal? @db.Decimal(12, 2)
  stock      Int      @default(0)
  image      String?
  active     Boolean  @default(true)

  attributeValues VariationAttributeValue[]
  orderItems      OrderItem[]
  cartItems       CartItem[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productId])
  @@map("product_variations")
}

model VariationAttributeValue {
  variationId      String
  attributeValueId String
  variation        ProductVariation @relation(fields: [variationId], references: [id], onDelete: Cascade)
  attributeValue   AttributeValue   @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([variationId, attributeValueId])
  @@map("variation_attribute_values")
}

// ============================================================
//  ESTOQUE
// ============================================================

model StockMovement {
  id          String            @id @default(uuid())
  productId   String
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        StockMovementType
  quantity    Int
  previous    Int
  current     Int
  reason      String?
  reference   String? // pedido, inventario...
  userId      String?
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())

  @@index([productId])
  @@index([type])
  @@map("stock_movements")
}

// ============================================================
//  CARRINHO
// ============================================================

model Cart {
  id        String     @id @default(uuid())
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String? // carrinho de visitante
  items     CartItem[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
  @@index([sessionId])
  @@map("carts")
}

model CartItem {
  id          String            @id @default(uuid())
  cartId      String
  cart        Cart              @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId   String
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variationId String?
  variation   ProductVariation? @relation(fields: [variationId], references: [id], onDelete: SetNull)
  quantity    Int               @default(1)
  unitPrice   Decimal           @db.Decimal(12, 2)

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([cartId])
  @@map("cart_items")
}

// ============================================================
//  PEDIDOS / PAGAMENTOS / FRETE
// ============================================================

model Order {
  id                String        @id @default(uuid())
  number            String        @unique
  userId            String?
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  status            OrderStatus   @default(PENDENTE)

  subtotal          Decimal       @db.Decimal(12, 2)
  discount          Decimal       @default(0) @db.Decimal(12, 2)
  shippingCost      Decimal       @default(0) @db.Decimal(12, 2)
  tax               Decimal       @default(0) @db.Decimal(12, 2)
  total             Decimal       @db.Decimal(12, 2)

  couponId          String?
  coupon            Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)

  shippingAddressId String?
  shippingAddress   Address?      @relation("ShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  billingAddressId  String?
  billingAddress    Address?      @relation("BillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)

  notes             String?

  items             OrderItem[]
  payments          Payment[]
  shipments         Shipment[]
  statusHistory     OrderStatusHistory[]

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id          String            @id @default(uuid())
  orderId     String
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  variationId String?
  variation   ProductVariation? @relation(fields: [variationId], references: [id], onDelete: SetNull)
  name        String // snapshot do nome
  sku         String?
  quantity    Int
  unitPrice   Decimal           @db.Decimal(12, 2)
  total       Decimal           @db.Decimal(12, 2)

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
  @@map("order_status_history")
}

model Payment {
  id            String         @id @default(uuid())
  orderId       String
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method        PaymentMethod
  gateway       PaymentGateway @default(MANUAL)
  status        PaymentStatus  @default(PENDENTE)
  amount        Decimal        @db.Decimal(12, 2)
  transactionId String?
  installments  Int            @default(1)
  paidAt        DateTime?
  rawPayload    Json?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([orderId])
  @@map("payments")
}

model Shipment {
  id            String          @id @default(uuid())
  orderId       String
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier       ShippingCarrier
  service       String?
  trackingCode  String?
  cost          Decimal         @db.Decimal(12, 2)
  estimatedDays Int?
  shippedAt     DateTime?
  deliveredAt   DateTime?

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([orderId])
  @@map("shipments")
}

model ShippingRate {
  id            String          @id @default(uuid())
  carrier       ShippingCarrier
  service       String
  zipFrom       String
  zipTo         String
  cost          Decimal         @db.Decimal(12, 2)
  estimatedDays Int
  active        Boolean         @default(true)

  createdAt     DateTime        @default(now())

  @@map("shipping_rates")
}

// ============================================================
//  CUPONS
// ============================================================

model Coupon {
  id           String      @id @default(uuid())
  code         String      @unique
  description  String?
  type         CouponType
  value        Decimal     @db.Decimal(12, 2)
  minPurchase  Decimal?    @db.Decimal(12, 2)
  maxUses      Int?
  usedCount    Int         @default(0)
  perUserLimit Int?
  startsAt     DateTime?
  expiresAt    DateTime?
  active       Boolean     @default(true)

  categories   CouponCategory[]
  products     CouponProduct[]
  usages       CouponUsage[]
  orders       Order[]

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("coupons")
}

model CouponCategory {
  couponId   String
  categoryId String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
  @@map("coupon_categories")
}

model CouponProduct {
  couponId  String
  productId String
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
  @@map("coupon_products")
}

model CouponUsage {
  id        String   @id @default(uuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId   String?
  discount  Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  @@index([couponId])
  @@map("coupon_usages")
}

// ============================================================
//  AVALIACOES
// ============================================================

model Review {
  id        String       @id @default(uuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int // 1..5
  title     String?
  comment   String?
  status    ReviewStatus @default(PENDENTE)
  photos    ReviewPhoto[]

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([productId])
  @@index([status])
  @@map("reviews")
}

model ReviewPhoto {
  id       String @id @default(uuid())
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  url      String

  @@index([reviewId])
  @@map("review_photos")
}

// ============================================================
//  BLOG
// ============================================================

model BlogCategory {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  posts       Post[]

  createdAt   DateTime @default(now())

  @@map("blog_categories")
}

model Post {
  id          String       @id @default(uuid())
  title       String
  slug        String       @unique
  excerpt     String?
  content     String
  coverImage  String?
  status      PostStatus   @default(RASCUNHO)
  publishedAt DateTime?

  authorId    String?
  author      User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  categoryId  String?
  category    BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // SEO
  metaTitle       String?
  metaDescription String?

  comments    Comment[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
  @@map("posts")
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName String?
  content   String
  approved  Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([postId])
  @@map("comments")
}

// ============================================================
//  NOTIFICACOES
// ============================================================

model Notification {
  id        String              @id @default(uuid())
  userId    String?
  user      User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  status    NotificationStatus  @default(PENDENTE)
  title     String
  message   String
  readAt    DateTime?
  sentAt    DateTime?

  createdAt DateTime            @default(now())

  @@index([userId])
  @@map("notifications")
}

// ============================================================
//  CONFIGURACOES DA LOJA
// ============================================================

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  group     String   @default("geral") // loja, seo, smtp, integracoes, moedas, impostos...

  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ============================================================
//  AUDITORIA
// ============================================================

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     AuditAction
  entity     String
  entityId   String?
  changes    Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  @@index([entity])
  @@index([userId])
  @@map("audit_logs")
}
